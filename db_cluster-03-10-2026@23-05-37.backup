--
-- Name: objects storage_couple_delete; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY storage_couple_delete ON storage.objects FOR DELETE TO authenticated USING (((bucket_id = ANY (ARRAY['avatars'::text, 'memories'::text, 'photos'::text, 'assets'::text])) AND public.is_couple_member(public.storage_object_couple_id(name))));


--
-- Name: objects storage_couple_insert; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY storage_couple_insert ON storage.objects FOR INSERT TO authenticated WITH CHECK (((bucket_id = ANY (ARRAY['avatars'::text, 'memories'::text, 'photos'::text, 'assets'::text])) AND public.is_couple_member(public.storage_object_couple_id(name))));


--
-- Name: objects storage_couple_select; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY storage_couple_select ON storage.objects FOR SELECT TO authenticated USING (((bucket_id = ANY (ARRAY['avatars'::text, 'memories'::text, 'photos'::text, 'assets'::text])) AND public.is_couple_member(public.storage_object_couple_id(name))));


--
-- Name: objects storage_couple_update; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY storage_couple_update ON storage.objects FOR UPDATE TO authenticated USING (((bucket_id = ANY (ARRAY['avatars'::text, 'memories'::text, 'photos'::text, 'assets'::text])) AND public.is_couple_member(public.storage_object_couple_id(name)))) WITH CHECK (((bucket_id = ANY (ARRAY['avatars'::text, 'memories'::text, 'photos'::text, 'assets'::text])) AND public.is_couple_member(public.storage_object_couple_id(name))));


--
-- Name: objects supabase 1ohtrhb_0; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "supabase 1ohtrhb_0" ON storage.objects FOR SELECT USING ((bucket_id = 'memories'::text));


--
-- Name: objects supabase 1ohtrhb_1; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "supabase 1ohtrhb_1" ON storage.objects FOR INSERT WITH CHECK ((bucket_id = 'memories'::text));


--
-- Name: objects supabase 1ohtrhb_2; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
