--
-- Data for Name: schema_migrations; Type: TABLE DATA; Schema: supabase_migrations; Owner: postgres
--

COPY supabase_migrations.schema_migrations (version, statements, name) FROM stdin;
20260605085416	{"/*\n# CUONGISME DATABASE BASE SCHEMA\n# Version: 20260605085416\n#\n# PURPOSE\n# - Create the base application schema.\n# - Support existing/legacy databases safely.\n# - Add couple_id to couple-owned tables.\n# - Keep application tables protected by RLS.\n# - Do NOT create universal anonymous CRUD policies.\n# - Create private Supabase Storage buckets.\n# - Do NOT modify ownership or RLS state of storage.objects.\n#\n# AUTHORIZATION MODEL\n# The follow-up migration:\n#   20260914000000_auth_membership_security.sql\n#\n# is responsible for:\n# - public.couple_members\n# - public.couple_invites\n# - membership authorization functions\n# - membership-based RLS policies\n# - Storage object policies\n#\n# IMPORTANT\n# - CREATE TABLE IF NOT EXISTS does NOT modify an existing table.\n# - Therefore legacy tables are explicitly upgraded below.\n# - Existing legacy rows may retain NULL couple_id.\n# - Such rows remain inaccessible until explicitly associated\n#   with a verified couple membership.\n*/\n\nBEGIN","-- =========================================================\n-- 1. COUPLE PROFILE\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.couple_profile (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  partner1_name text NOT NULL DEFAULT '',\n  partner1_avatar text NOT NULL DEFAULT '',\n  partner1_gender text NOT NULL DEFAULT '',\n  partner1_birthday date,\n\n  partner2_name text NOT NULL DEFAULT '',\n  partner2_avatar text NOT NULL DEFAULT '',\n  partner2_gender text NOT NULL DEFAULT '',\n  partner2_birthday date,\n\n  relationship_status text NOT NULL DEFAULT 'dating',\n  relationship_start date NOT NULL DEFAULT CURRENT_DATE,\n\n  created_at timestamptz NOT NULL DEFAULT now(),\n  updated_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 2. TIMELINE EVENTS\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.timeline_events (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  title text NOT NULL,\n  date date NOT NULL,\n  event_type text NOT NULL DEFAULT 'custom',\n  story text NOT NULL DEFAULT '',\n  photos text[] NOT NULL DEFAULT '{}',\n  location text NOT NULL DEFAULT '',\n  mood text NOT NULL DEFAULT '',\n  tags text[] NOT NULL DEFAULT '{}',\n  sort_order integer NOT NULL DEFAULT 0,\n\n  created_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 3. MEMORIES\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.memories (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  title text NOT NULL,\n  category text NOT NULL DEFAULT 'photo',\n  url text NOT NULL DEFAULT '',\n  description text NOT NULL DEFAULT '',\n  is_favorite boolean NOT NULL DEFAULT false,\n  date date NOT NULL DEFAULT CURRENT_DATE,\n  tags text[] NOT NULL DEFAULT '{}',\n\n  created_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 4. LOVE LETTERS\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.love_letters (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  title text NOT NULL DEFAULT '',\n  content text NOT NULL DEFAULT '',\n\n  from_partner text NOT NULL DEFAULT 'partner1',\n  to_partner text NOT NULL DEFAULT 'partner2',\n\n  is_draft boolean NOT NULL DEFAULT true,\n  is_locked boolean NOT NULL DEFAULT false,\n\n  scheduled_at timestamptz,\n  is_future boolean NOT NULL DEFAULT false,\n\n  reaction text NOT NULL DEFAULT '',\n\n  created_at timestamptz NOT NULL DEFAULT now(),\n  delivered_at timestamptz\n)","-- =========================================================\n-- 5. JOURNAL ENTRIES\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.journal_entries (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  date date NOT NULL DEFAULT CURRENT_DATE,\n  content text NOT NULL DEFAULT '',\n  mood text NOT NULL DEFAULT '',\n  photos text[] NOT NULL DEFAULT '{}',\n\n  created_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 6. MOOD ENTRIES\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.mood_entries (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  mood text NOT NULL,\n  note text NOT NULL DEFAULT '',\n  partner text NOT NULL DEFAULT 'partner1',\n\n  created_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 7. BUCKET LIST ITEMS\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.bucket_list_items (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  title text NOT NULL,\n  category text NOT NULL DEFAULT 'travel',\n  description text NOT NULL DEFAULT '',\n\n  is_completed boolean NOT NULL DEFAULT false,\n  completed_at timestamptz,\n\n  image_url text NOT NULL DEFAULT '',\n\n  created_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 8. ANNIVERSARIES\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.anniversaries (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  title text NOT NULL,\n  date date NOT NULL,\n\n  anniversary_type text NOT NULL DEFAULT 'custom',\n  recurrence text NOT NULL DEFAULT 'yearly',\n\n  photo_url text,\n\n  created_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 9. MAP LOCATIONS\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.map_locations (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  title text NOT NULL,\n  description text NOT NULL DEFAULT '',\n\n  latitude double precision NOT NULL DEFAULT 0,\n  longitude double precision NOT NULL DEFAULT 0,\n\n  location_type text NOT NULL DEFAULT 'date',\n  photos text[] NOT NULL DEFAULT '{}',\n\n  memory_id uuid\n    REFERENCES public.memories(id)\n    ON DELETE SET NULL,\n\n  created_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 10. SONGS\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.songs (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  title text NOT NULL,\n  artist text NOT NULL DEFAULT '',\n  url text NOT NULL DEFAULT '',\n\n  is_favorite boolean NOT NULL DEFAULT false,\n  is_background boolean NOT NULL DEFAULT false,\n\n  created_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 11. GIFTS\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.gifts (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  title text NOT NULL,\n  description text NOT NULL DEFAULT '',\n  url text NOT NULL DEFAULT '',\n  image_url text NOT NULL DEFAULT '',\n\n  category text NOT NULL DEFAULT 'wishlist',\n  occasion text NOT NULL DEFAULT '',\n  price_range text NOT NULL DEFAULT '',\n\n  is_received boolean NOT NULL DEFAULT false,\n  for_partner text NOT NULL DEFAULT 'partner2',\n\n  created_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 12. MESSAGES\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.messages (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  content text NOT NULL,\n  message_type text NOT NULL DEFAULT 'note',\n  is_pinned boolean NOT NULL DEFAULT false,\n\n  created_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 13. SETTINGS\n-- =========================================================\n\nCREATE TABLE IF NOT EXISTS public.settings (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n\n  couple_id uuid\n    REFERENCES public.couple_profile(id)\n    ON DELETE CASCADE,\n\n  language text NOT NULL DEFAULT 'en',\n  theme text NOT NULL DEFAULT 'dark',\n\n  contact_links jsonb NOT NULL DEFAULT '[]'::jsonb,\n\n  privacy_mode boolean NOT NULL DEFAULT false,\n\n  /*\n   * Legacy compatibility.\n   * This MUST NOT be used as an authorization mechanism.\n   */\n  privacy_password text,\n\n  /*\n   * Legacy compatibility.\n   * Authentication/authorization MUST NOT depend on this field.\n   */\n  password_hash text NOT NULL DEFAULT '',\n\n  notifications_enabled boolean NOT NULL DEFAULT true,\n\n  created_at timestamptz NOT NULL DEFAULT now(),\n  updated_at timestamptz NOT NULL DEFAULT now()\n)","-- =========================================================\n-- 14. LEGACY SCHEMA UPGRADE\n--\n-- CREATE TABLE IF NOT EXISTS will not modify an existing\n-- table. Existing remote tables therefore need explicit\n-- ALTER TABLE ... ADD COLUMN IF NOT EXISTS statements.\n--\n-- Do this BEFORE creating indexes or policies depending on\n-- couple_id.\n-- =========================================================\n\nALTER TABLE public.timeline_events\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.memories\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.love_letters\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.journal_entries\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.mood_entries\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.bucket_list_items\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.anniversaries\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.map_locations\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.songs\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.gifts\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.messages\n  ADD COLUMN IF NOT EXISTS couple_id uuid","ALTER TABLE public.settings\n  ADD COLUMN IF NOT EXISTS couple_id uuid","-- =========================================================\n-- 15. LEGACY COLUMN COMPATIBILITY\n--\n-- Add columns that are required by the current application\n-- when an older copy of the table is missing them.\n-- =========================================================\n\nALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS partner1_name text","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS partner1_avatar text","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS partner1_gender text","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS partner1_birthday date","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS partner2_name text","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS partner2_avatar text","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS partner2_gender text","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS partner2_birthday date","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS relationship_status text","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS relationship_start date","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS created_at timestamptz","ALTER TABLE public.couple_profile\n  ADD COLUMN IF NOT EXISTS updated_at timestamptz","ALTER TABLE public.bucket_list_items\n  ADD COLUMN IF NOT EXISTS image_url text","ALTER TABLE public.anniversaries\n  ADD COLUMN IF NOT EXISTS photo_url text","ALTER TABLE public.settings\n  ADD COLUMN IF NOT EXISTS language text","ALTER TABLE public.settings\n  ADD COLUMN IF NOT EXISTS theme text","ALTER TABLE public.settings\n  ADD COLUMN IF NOT EXISTS contact_links jsonb","ALTER TABLE public.settings\n  ADD COLUMN IF NOT EXISTS privacy_mode boolean","ALTER TABLE public.settings\n  ADD COLUMN IF NOT EXISTS privacy_password text","ALTER TABLE public.settings\n  ADD COLUMN IF NOT EXISTS password_hash text","ALTER TABLE public.settings\n  ADD COLUMN IF NOT EXISTS notifications_enabled boolean","ALTER TABLE public.settings\n  ADD COLUMN IF NOT EXISTS created_at timestamptz","ALTER TABLE public.settings\n  ADD COLUMN IF NOT EXISTS updated_at timestamptz","-- =========================================================\n-- 16. BACKFILL SAFE DEFAULTS\n--\n-- These only populate missing values. They do not assign\n-- legacy records to a couple automatically.\n-- =========================================================\n\nUPDATE public.couple_profile\nSET partner1_name = COALESCE(partner1_name, ''),\n    partner1_avatar = COALESCE(partner1_avatar, ''),\n    partner1_gender = COALESCE(partner1_gender, ''),\n    partner2_name = COALESCE(partner2_name, ''),\n    partner2_avatar = COALESCE(partner2_avatar, ''),\n    partner2_gender = COALESCE(partner2_gender, ''),\n    relationship_status = COALESCE(relationship_status, 'dating'),\n    relationship_start = COALESCE(relationship_start, CURRENT_DATE),\n    created_at = COALESCE(created_at, now()),\n    updated_at = COALESCE(updated_at, now())","UPDATE public.settings\nSET language = COALESCE(language, 'en'),\n    theme = COALESCE(theme, 'dark'),\n    contact_links = COALESCE(contact_links, '[]'::jsonb),\n    privacy_mode = COALESCE(privacy_mode, false),\n    password_hash = COALESCE(password_hash, ''),\n    notifications_enabled = COALESCE(notifications_enabled, true),\n    created_at = COALESCE(created_at, now()),\n    updated_at = COALESCE(updated_at, now())","-- =========================================================\n-- 17. FOREIGN KEYS\n--\n-- Existing databases may already have these constraints.\n-- Add them only when absent.\n-- =========================================================\n\nDO $$\nBEGIN\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'timeline_events_couple_id_fkey'\n      AND conrelid = 'public.timeline_events'::regclass\n  ) THEN\n\n    ALTER TABLE public.timeline_events\n      ADD CONSTRAINT timeline_events_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'memories_couple_id_fkey'\n      AND conrelid = 'public.memories'::regclass\n  ) THEN\n\n    ALTER TABLE public.memories\n      ADD CONSTRAINT memories_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'love_letters_couple_id_fkey'\n      AND conrelid = 'public.love_letters'::regclass\n  ) THEN\n\n    ALTER TABLE public.love_letters\n      ADD CONSTRAINT love_letters_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'journal_entries_couple_id_fkey'\n      AND conrelid = 'public.journal_entries'::regclass\n  ) THEN\n\n    ALTER TABLE public.journal_entries\n      ADD CONSTRAINT journal_entries_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'mood_entries_couple_id_fkey'\n      AND conrelid = 'public.mood_entries'::regclass\n  ) THEN\n\n    ALTER TABLE public.mood_entries\n      ADD CONSTRAINT mood_entries_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'bucket_list_items_couple_id_fkey'\n      AND conrelid = 'public.bucket_list_items'::regclass\n  ) THEN\n\n    ALTER TABLE public.bucket_list_items\n      ADD CONSTRAINT bucket_list_items_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'anniversaries_couple_id_fkey'\n      AND conrelid = 'public.anniversaries'::regclass\n  ) THEN\n\n    ALTER TABLE public.anniversaries\n      ADD CONSTRAINT anniversaries_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'map_locations_couple_id_fkey'\n      AND conrelid = 'public.map_locations'::regclass\n  ) THEN\n\n    ALTER TABLE public.map_locations\n      ADD CONSTRAINT map_locations_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'songs_couple_id_fkey'\n      AND conrelid = 'public.songs'::regclass\n  ) THEN\n\n    ALTER TABLE public.songs\n      ADD CONSTRAINT songs_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'gifts_couple_id_fkey'\n      AND conrelid = 'public.gifts'::regclass\n  ) THEN\n\n    ALTER TABLE public.gifts\n      ADD CONSTRAINT gifts_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'messages_couple_id_fkey'\n      AND conrelid = 'public.messages'::regclass\n  ) THEN\n\n    ALTER TABLE public.messages\n      ADD CONSTRAINT messages_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM pg_constraint\n    WHERE conname = 'settings_couple_id_fkey'\n      AND conrelid = 'public.settings'::regclass\n  ) THEN\n\n    ALTER TABLE public.settings\n      ADD CONSTRAINT settings_couple_id_fkey\n      FOREIGN KEY (couple_id)\n      REFERENCES public.couple_profile(id)\n      ON DELETE CASCADE;\n\n  END IF;\n\nEND $$","-- =========================================================\n-- 18. INDEXES\n--\n-- Must happen AFTER couple_id compatibility columns exist.\n-- =========================================================\n\nCREATE INDEX IF NOT EXISTS timeline_events_couple_id_idx\n  ON public.timeline_events(couple_id)","CREATE INDEX IF NOT EXISTS memories_couple_id_idx\n  ON public.memories(couple_id)","CREATE INDEX IF NOT EXISTS love_letters_couple_id_idx\n  ON public.love_letters(couple_id)","CREATE INDEX IF NOT EXISTS journal_entries_couple_id_idx\n  ON public.journal_entries(couple_id)","CREATE INDEX IF NOT EXISTS mood_entries_couple_id_idx\n  ON public.mood_entries(couple_id)","CREATE INDEX IF NOT EXISTS bucket_list_items_couple_id_idx\n  ON public.bucket_list_items(couple_id)","CREATE INDEX IF NOT EXISTS anniversaries_couple_id_idx\n  ON public.anniversaries(couple_id)","CREATE INDEX IF NOT EXISTS map_locations_couple_id_idx\n  ON public.map_locations(couple_id)","CREATE INDEX IF NOT EXISTS map_locations_memory_id_idx\n  ON public.map_locations(memory_id)","CREATE INDEX IF NOT EXISTS songs_couple_id_idx\n  ON public.songs(couple_id)","CREATE INDEX IF NOT EXISTS gifts_couple_id_idx\n  ON public.gifts(couple_id)","CREATE INDEX IF NOT EXISTS messages_couple_id_idx\n  ON public.messages(couple_id)","CREATE INDEX IF NOT EXISTS settings_couple_id_idx\n  ON public.settings(couple_id)","-- =========================================================\n-- 19. ENABLE RLS ON APPLICATION TABLES\n-- =========================================================\n\nALTER TABLE public.couple_profile ENABLE ROW LEVEL SECURITY","ALTER TABLE public.timeline_events ENABLE ROW LEVEL SECURITY","ALTER TABLE public.memories ENABLE ROW LEVEL SECURITY","ALTER TABLE public.love_letters ENABLE ROW LEVEL SECURITY","ALTER TABLE public.journal_entries ENABLE ROW LEVEL SECURITY","ALTER TABLE public.mood_entries ENABLE ROW LEVEL SECURITY","ALTER TABLE public.bucket_list_items ENABLE ROW LEVEL SECURITY","ALTER TABLE public.anniversaries ENABLE ROW LEVEL SECURITY","ALTER TABLE public.map_locations ENABLE ROW LEVEL SECURITY","ALTER TABLE public.songs ENABLE ROW LEVEL SECURITY","ALTER TABLE public.gifts ENABLE ROW LEVEL SECURITY","ALTER TABLE public.messages ENABLE ROW LEVEL SECURITY","ALTER TABLE public.settings ENABLE ROW LEVEL SECURITY","-- =========================================================\n-- 20. REMOVE LEGACY OPEN POLICIES\n--\n-- IMPORTANT:\n-- No universal USING (true) or WITH CHECK (true) policy\n-- is created here.\n--\n-- The later authentication/membership migration creates\n-- the actual authorization boundary.\n-- =========================================================\n\nDO $$\nDECLARE\n  t text;\nBEGIN\n\n  FOR t IN\n    SELECT unnest(ARRAY[\n      'couple_profile',\n      'timeline_events',\n      'memories',\n      'love_letters',\n      'journal_entries',\n      'mood_entries',\n      'bucket_list_items',\n      'anniversaries',\n      'map_locations',\n      'songs',\n      'gifts',\n      'messages',\n      'settings'\n    ])\n  LOOP\n\n    EXECUTE format(\n      'DROP POLICY IF EXISTS %I ON public.%I',\n      'anon_select_' || t,\n      t\n    );\n\n    EXECUTE format(\n      'DROP POLICY IF EXISTS %I ON public.%I',\n      'anon_insert_' || t,\n      t\n    );\n\n    EXECUTE format(\n      'DROP POLICY IF EXISTS %I ON public.%I',\n      'anon_update_' || t,\n      t\n    );\n\n    EXECUTE format(\n      'DROP POLICY IF EXISTS %I ON public.%I',\n      'anon_delete_' || t,\n      t\n    );\n\n    EXECUTE format(\n      'DROP POLICY IF EXISTS %I ON public.%I',\n      'couple_member_select_' || t,\n      t\n    );\n\n    EXECUTE format(\n      'DROP POLICY IF EXISTS %I ON public.%I',\n      'couple_member_insert_' || t,\n      t\n    );\n\n    EXECUTE format(\n      'DROP POLICY IF EXISTS %I ON public.%I',\n      'couple_member_update_' || t,\n      t\n    );\n\n    EXECUTE format(\n      'DROP POLICY IF EXISTS %I ON public.%I',\n      'couple_member_delete_' || t,\n      t\n    );\n\n  END LOOP;\n\nEND $$","-- =========================================================\n-- 21. DEFAULT COUPLE + SETTINGS\n--\n-- Ensure settings is linked to the exact couple row.\n-- Do not create an orphan settings row with NULL couple_id.\n-- =========================================================\n\nDO $$\nDECLARE\n  default_couple_id uuid;\nBEGIN\n\n  SELECT cp.id\n  INTO default_couple_id\n  FROM public.couple_profile cp\n  ORDER BY cp.created_at NULLS FIRST, cp.id\n  LIMIT 1;\n\n  IF default_couple_id IS NULL THEN\n\n    INSERT INTO public.couple_profile (\n      partner1_name,\n      partner2_name,\n      relationship_status,\n      relationship_start\n    )\n    VALUES (\n      'Cuong',\n      'Love',\n      'dating',\n      CURRENT_DATE\n    )\n    RETURNING id INTO default_couple_id;\n\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1\n    FROM public.settings s\n    WHERE s.couple_id = default_couple_id\n  ) THEN\n\n    INSERT INTO public.settings (\n      couple_id,\n      language,\n      theme,\n      contact_links,\n      privacy_mode,\n      privacy_password,\n      password_hash,\n      notifications_enabled\n    )\n    VALUES (\n      default_couple_id,\n      'en',\n      'dark',\n      '[]'::jsonb,\n      false,\n      NULL,\n      '',\n      true\n    );\n\n  END IF;\n\nEND $$","-- =========================================================\n-- 22. UPDATED_AT TRIGGERS\n-- =========================================================\n\nCREATE OR REPLACE FUNCTION public.set_couple_profile_updated_at()\nRETURNS trigger\nLANGUAGE plpgsql\nAS $$\nBEGIN\n  NEW.updated_at = now();\n  RETURN NEW;\nEND;\n$$","DROP TRIGGER IF EXISTS couple_profile_updated_at\nON public.couple_profile","CREATE TRIGGER couple_profile_updated_at\nBEFORE UPDATE ON public.couple_profile\nFOR EACH ROW\nEXECUTE FUNCTION public.set_couple_profile_updated_at()","CREATE OR REPLACE FUNCTION public.set_settings_updated_at()\nRETURNS trigger\nLANGUAGE plpgsql\nAS $$\nBEGIN\n  NEW.updated_at = now();\n  RETURN NEW;\nEND;\n$$","DROP TRIGGER IF EXISTS settings_updated_at\nON public.settings","CREATE TRIGGER settings_updated_at\nBEFORE UPDATE ON public.settings\nFOR EACH ROW\nEXECUTE FUNCTION public.set_settings_updated_at()","-- =========================================================\n-- 23. SUPABASE STORAGE BUCKETS\n--\n-- Buckets are PRIVATE.\n--\n-- Do NOT:\n-- - ALTER storage.objects\n-- - ALTER ownership of storage objects\n-- - GRANT ALL on schema storage\n-- - create universal anon policies\n--\n-- The later security migration is responsible for\n-- storage.objects authorization policies.\n-- =========================================================\n\nINSERT INTO storage.buckets (\n  id,\n  name,\n  public\n)\nVALUES\n  ('avatars',  'avatars',  false),\n  ('memories', 'memories', false),\n  ('photos',   'photos',   false),\n  ('assets',   'assets',   false)\nON CONFLICT (id)\nDO UPDATE SET\n  public = EXCLUDED.public","-- =========================================================\n-- 24. SECURITY BASELINE\n--\n-- At this stage:\n--\n-- 1. Application tables exist.\n-- 2. couple_id compatibility columns exist.\n-- 3. Foreign keys exist.\n-- 4. Indexes exist.\n-- 5. RLS is enabled.\n-- 6. Legacy open policies are removed.\n-- 7. Storage buckets are private.\n-- 8. Storage ownership is untouched.\n--\n-- Authorization is intentionally finalized by:\n--\n-- 20260914000000_auth_membership_security.sql\n--\n-- which creates:\n--   public.couple_members\n--   public.couple_invites\n--   membership functions\n--   membership-bound policies\n--   private Storage policies.\n-- =========================================================\n\nCOMMIT"}	create_cuongisme_schema
20260823000000	{"/*\n# Create Personal OS & Infinite Personalization Database Schema\n\n1. New Tables:\n   - `user_personalization`: Holds active appearance, background, identity styling, navigation preferences.\n   - `user_workspaces`: Multi-workspace configurations with responsive layout mode and block assignments.\n   - `user_custom_pages`: Dynamic user-created pages with modular block configurations.\n   - `user_assets`: Persistent media library (avatars, banners, backgrounds, stickers, photos).\n   - `user_saved_views`: Saved filters, sorting and layout state for different views.\n   - `user_rules`: User condition-action automation rules.\n   - `user_presets`: User-saved design presets.\n   - `user_config_revisions`: Snapshot history for undo, redo, and rollback.\n\n2. Security:\n   - Row Level Security (RLS) enabled on all tables.\n   - Policies configured for anonymous and authenticated access.\n*/\n\n-- 1. User Personalization Master Table\nCREATE TABLE IF NOT EXISTS user_personalization (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  couple_id uuid REFERENCES couple_profile(id) ON DELETE CASCADE,\n  appearance jsonb NOT NULL DEFAULT '{}'::jsonb,\n  background jsonb NOT NULL DEFAULT '{}'::jsonb,\n  identity jsonb NOT NULL DEFAULT '{}'::jsonb,\n  navigation jsonb NOT NULL DEFAULT '{}'::jsonb,\n  active_workspace_id text DEFAULT 'ws-main',\n  created_at timestamptz DEFAULT now(),\n  updated_at timestamptz DEFAULT now()\n)","-- 2. User Workspaces\nCREATE TABLE IF NOT EXISTS user_workspaces (\n  id text PRIMARY KEY,\n  couple_id uuid REFERENCES couple_profile(id) ON DELETE CASCADE,\n  name text NOT NULL,\n  icon text NOT NULL DEFAULT 'Heart',\n  description text DEFAULT '',\n  is_default boolean DEFAULT false,\n  layout_mode text NOT NULL DEFAULT 'bento',\n  blocks jsonb NOT NULL DEFAULT '[]'::jsonb,\n  theme_override jsonb,\n  background_override jsonb,\n  navigation_override jsonb,\n  active_page_id text,\n  created_at timestamptz DEFAULT now(),\n  updated_at timestamptz DEFAULT now()\n)","-- 3. User Custom Pages\nCREATE TABLE IF NOT EXISTS user_custom_pages (\n  id text PRIMARY KEY,\n  couple_id uuid REFERENCES couple_profile(id) ON DELETE CASCADE,\n  workspace_id text REFERENCES user_workspaces(id) ON DELETE CASCADE,\n  title text NOT NULL,\n  slug text NOT NULL,\n  icon text NOT NULL DEFAULT 'FileText',\n  description text DEFAULT '',\n  blocks jsonb NOT NULL DEFAULT '[]'::jsonb,\n  is_default boolean DEFAULT false,\n  created_at timestamptz DEFAULT now(),\n  updated_at timestamptz DEFAULT now()\n)","-- 4. User Media Assets Library\nCREATE TABLE IF NOT EXISTS user_assets (\n  id text PRIMARY KEY,\n  couple_id uuid REFERENCES couple_profile(id) ON DELETE CASCADE,\n  name text NOT NULL,\n  category text NOT NULL DEFAULT 'photo',\n  url text NOT NULL,\n  thumbnail text,\n  size bigint DEFAULT 0,\n  mime_type text DEFAULT 'image/jpeg',\n  tags text[] DEFAULT '{}',\n  is_favorite boolean DEFAULT false,\n  created_at timestamptz DEFAULT now()\n)","-- 5. Saved Views\nCREATE TABLE IF NOT EXISTS user_saved_views (\n  id text PRIMARY KEY,\n  couple_id uuid REFERENCES couple_profile(id) ON DELETE CASCADE,\n  page_key text NOT NULL,\n  name text NOT NULL,\n  icon text NOT NULL DEFAULT 'Bookmark',\n  description text DEFAULT '',\n  filters jsonb NOT NULL DEFAULT '{}'::jsonb,\n  sort_by text,\n  sort_order text DEFAULT 'desc',\n  display_mode text DEFAULT 'grid',\n  is_default boolean DEFAULT false,\n  created_at timestamptz DEFAULT now()\n)","-- 6. Personal Automation Rules\nCREATE TABLE IF NOT EXISTS user_rules (\n  id text PRIMARY KEY,\n  couple_id uuid REFERENCES couple_profile(id) ON DELETE CASCADE,\n  name text NOT NULL,\n  trigger text NOT NULL,\n  condition jsonb NOT NULL DEFAULT '{}'::jsonb,\n  action text NOT NULL,\n  action_payload jsonb NOT NULL DEFAULT '{}'::jsonb,\n  is_enabled boolean DEFAULT true,\n  created_at timestamptz DEFAULT now()\n)","-- 7. User Saved Presets & Templates\nCREATE TABLE IF NOT EXISTS user_presets (\n  id text PRIMARY KEY,\n  couple_id uuid REFERENCES couple_profile(id) ON DELETE CASCADE,\n  name text NOT NULL,\n  description text DEFAULT '',\n  category text DEFAULT 'Custom',\n  author text DEFAULT 'User',\n  version text DEFAULT '1.0.0',\n  preview_thumbnail text,\n  tags text[] DEFAULT '{}',\n  appearance jsonb NOT NULL DEFAULT '{}'::jsonb,\n  background jsonb NOT NULL DEFAULT '{}'::jsonb,\n  navigation_style text DEFAULT 'floating_dock',\n  identity_decoration jsonb DEFAULT '{}'::jsonb,\n  sample_blocks jsonb DEFAULT '[]'::jsonb,\n  created_at timestamptz DEFAULT now()\n)","-- 8. Configuration Snapshots & Revision History\nCREATE TABLE IF NOT EXISTS user_config_revisions (\n  id text PRIMARY KEY,\n  couple_id uuid REFERENCES couple_profile(id) ON DELETE CASCADE,\n  timestamp timestamptz DEFAULT now(),\n  label text NOT NULL DEFAULT 'Snapshot',\n  snapshot jsonb NOT NULL\n)","-- Enable RLS for all new tables\nALTER TABLE user_personalization ENABLE ROW LEVEL SECURITY","ALTER TABLE user_workspaces ENABLE ROW LEVEL SECURITY","ALTER TABLE user_custom_pages ENABLE ROW LEVEL SECURITY","ALTER TABLE user_assets ENABLE ROW LEVEL SECURITY","ALTER TABLE user_saved_views ENABLE ROW LEVEL SECURITY","ALTER TABLE user_rules ENABLE ROW LEVEL SECURITY","ALTER TABLE user_presets ENABLE ROW LEVEL SECURITY","ALTER TABLE user_config_revisions ENABLE ROW LEVEL SECURITY","-- Dynamic RLS policies for anonymous and authenticated access\nDO $$\nDECLARE\n  t text;\nBEGIN\n  FOR t IN SELECT unnest(ARRAY[\n    'user_personalization', 'user_workspaces', 'user_custom_pages',\n    'user_assets', 'user_saved_views', 'user_rules', 'user_presets', 'user_config_revisions'\n  ]) LOOP\n    EXECUTE format('DROP POLICY IF EXISTS %I ON %I', 'anon_select_' || t, t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON %I', 'anon_insert_' || t, t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON %I', 'anon_update_' || t, t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON %I', 'anon_delete_' || t, t);\n    EXECUTE format('CREATE POLICY %I ON %I FOR SELECT TO anon, authenticated USING (true)', 'anon_select_' || t, t);\n    EXECUTE format('CREATE POLICY %I ON %I FOR INSERT TO anon, authenticated WITH CHECK (true)', 'anon_insert_' || t, t);\n    EXECUTE format('CREATE POLICY %I ON %I FOR UPDATE TO anon, authenticated USING (true) WITH CHECK (true)', 'anon_update_' || t, t);\n    EXECUTE format('CREATE POLICY %I ON %I FOR DELETE TO anon, authenticated USING (true)', 'anon_delete_' || t, t);\n  END LOOP;\nEND $$"}	personal_os_schema
20260905000000	{"-- Migration: Establish couple_profile.relationship_start as canonical timestamptz\n-- 1. Ensure couple_profile.relationship_start supports full timestamp with time zone\nDO $$\nBEGIN\n  IF EXISTS (\n    SELECT 1 FROM information_schema.columns \n    WHERE table_name = 'couple_profile' AND column_name = 'relationship_start'\n  ) THEN\n    ALTER TABLE couple_profile \n      ALTER COLUMN relationship_start TYPE timestamptz USING relationship_start::timestamptz;\n  END IF;\nEND $$","-- 2. Clean up legacy relationshipStart from user_personalization JSONB identity\nDO $$\nBEGIN\n  IF EXISTS (\n    SELECT 1 FROM information_schema.tables WHERE table_name = 'user_personalization'\n  ) THEN\n    UPDATE user_personalization\n    SET identity = identity - 'relationshipStart'\n    WHERE identity ? 'relationshipStart';\n  END IF;\nEND $$"}	canonical_relationship_start
20260914000000	{"-- P0 security boundary: authenticated couples, private media, and membership RLS.\n-- Legacy rows/objects are intentionally retained. Rows without a verified member remain inaccessible.\n\nCREATE TABLE IF NOT EXISTS public.couple_members (\n  couple_id uuid NOT NULL REFERENCES public.couple_profile(id) ON DELETE CASCADE,\n  user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,\n  role text NOT NULL DEFAULT 'partner' CHECK (role IN ('owner', 'partner')),\n  created_at timestamptz NOT NULL DEFAULT now(),\n  PRIMARY KEY (couple_id, user_id)\n)","CREATE INDEX IF NOT EXISTS couple_members_user_id_idx ON public.couple_members(user_id)","CREATE TABLE IF NOT EXISTS public.couple_invites (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  couple_id uuid NOT NULL REFERENCES public.couple_profile(id) ON DELETE CASCADE,\n  email text NOT NULL,\n  token uuid NOT NULL UNIQUE DEFAULT gen_random_uuid(),\n  created_by uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,\n  expires_at timestamptz NOT NULL DEFAULT now() + interval '7 days',\n  accepted_at timestamptz,\n  created_at timestamptz NOT NULL DEFAULT now()\n)","CREATE INDEX IF NOT EXISTS couple_invites_couple_id_idx ON public.couple_invites(couple_id)","CREATE OR REPLACE FUNCTION public.is_couple_member(target_couple_id uuid)\nRETURNS boolean\nLANGUAGE sql\nSTABLE\nSECURITY DEFINER\nSET search_path = public\nAS $$\n  SELECT auth.uid() IS NOT NULL\n    AND EXISTS (\n      SELECT 1\n      FROM public.couple_members\n      WHERE couple_id = target_couple_id\n        AND user_id = auth.uid()\n    );\n$$","REVOKE ALL ON FUNCTION public.is_couple_member(uuid) FROM PUBLIC","GRANT EXECUTE ON FUNCTION public.is_couple_member(uuid) TO authenticated","CREATE OR REPLACE FUNCTION public.create_couple_for_current_user(\n  partner1_name text DEFAULT '',\n  partner2_name text DEFAULT ''\n)\nRETURNS uuid\nLANGUAGE plpgsql\nSECURITY DEFINER\nSET search_path = public\nAS $$\nDECLARE\n  new_couple_id uuid;\nBEGIN\n  IF auth.uid() IS NULL THEN\n    RAISE EXCEPTION 'Authentication is required';\n  END IF;\n\n  INSERT INTO public.couple_profile (partner1_name, partner2_name)\n  VALUES (COALESCE(partner1_name, ''), COALESCE(partner2_name, ''))\n  RETURNING id INTO new_couple_id;\n\n  INSERT INTO public.couple_members (couple_id, user_id, role)\n  VALUES (new_couple_id, auth.uid(), 'owner');\n\n  INSERT INTO public.settings (couple_id) VALUES (new_couple_id);\n\n  RETURN new_couple_id;\nEND;\n$$","CREATE OR REPLACE FUNCTION public.create_couple_invite(invitee_email text)\nRETURNS uuid\nLANGUAGE plpgsql\nSECURITY DEFINER\nSET search_path = public\nAS $$\nDECLARE\n  target_couple_id uuid;\n  invite_token uuid;\nBEGIN\n  IF auth.uid() IS NULL OR trim(coalesce(invitee_email, '')) = '' THEN\n    RAISE EXCEPTION 'Authentication and invitee email are required';\n  END IF;\n\n  SELECT couple_id INTO target_couple_id\n  FROM public.couple_members\n  WHERE user_id = auth.uid() AND role = 'owner'\n  ORDER BY created_at\n  LIMIT 1;\n\n  IF target_couple_id IS NULL THEN\n    RAISE EXCEPTION 'Only a couple owner can create an invite';\n  END IF;\n\n  INSERT INTO public.couple_invites (couple_id, email, created_by)\n  VALUES (target_couple_id, lower(trim(invitee_email)), auth.uid())\n  RETURNING token INTO invite_token;\n\n  RETURN invite_token;\nEND;\n$$","CREATE OR REPLACE FUNCTION public.accept_couple_invite(invite_token uuid)\nRETURNS uuid\nLANGUAGE plpgsql\nSECURITY DEFINER\nSET search_path = public\nAS $$\nDECLARE\n  target_invite public.couple_invites%ROWTYPE;\n  session_email text;\nBEGIN\n  IF auth.uid() IS NULL THEN\n    RAISE EXCEPTION 'Authentication is required';\n  END IF;\n\n  session_email := lower(coalesce(auth.jwt() ->> 'email', ''));\n  SELECT * INTO target_invite\n  FROM public.couple_invites\n  WHERE token = invite_token AND accepted_at IS NULL AND expires_at > now()\n  FOR UPDATE;\n\n  IF target_invite.id IS NULL OR session_email <> lower(target_invite.email) THEN\n    RAISE EXCEPTION 'Invite is invalid for this account';\n  END IF;\n\n  INSERT INTO public.couple_members (couple_id, user_id, role)\n  VALUES (target_invite.couple_id, auth.uid(), 'partner')\n  ON CONFLICT (couple_id, user_id) DO NOTHING;\n\n  UPDATE public.couple_invites SET accepted_at = now() WHERE id = target_invite.id;\n  RETURN target_invite.couple_id;\nEND;\n$$","REVOKE ALL ON FUNCTION public.create_couple_for_current_user(text, text) FROM PUBLIC","REVOKE ALL ON FUNCTION public.create_couple_invite(text) FROM PUBLIC","REVOKE ALL ON FUNCTION public.accept_couple_invite(uuid) FROM PUBLIC","GRANT EXECUTE ON FUNCTION public.create_couple_for_current_user(text, text) TO authenticated","GRANT EXECUTE ON FUNCTION public.create_couple_invite(text) TO authenticated","GRANT EXECUTE ON FUNCTION public.accept_couple_invite(uuid) TO authenticated","ALTER TABLE public.couple_members ENABLE ROW LEVEL SECURITY","ALTER TABLE public.couple_invites ENABLE ROW LEVEL SECURITY","DROP POLICY IF EXISTS couple_members_select_own ON public.couple_members","CREATE POLICY couple_members_select_own ON public.couple_members\n  FOR SELECT TO authenticated USING (user_id = auth.uid())","DROP POLICY IF EXISTS couple_invites_select_owner ON public.couple_invites","CREATE POLICY couple_invites_select_owner ON public.couple_invites\n  FOR SELECT TO authenticated USING (created_by = auth.uid())","-- Remove the legacy universal policies before creating membership-bound policies.\nDO $$\nDECLARE\n  t text;\nBEGIN\n  FOR t IN SELECT unnest(ARRAY[\n    'couple_profile', 'timeline_events', 'memories', 'love_letters',\n    'journal_entries', 'mood_entries', 'bucket_list_items', 'anniversaries',\n    'map_locations', 'songs', 'gifts', 'messages', 'settings',\n    'user_personalization', 'user_workspaces', 'user_custom_pages',\n    'user_assets', 'user_saved_views', 'user_rules', 'user_presets',\n    'user_config_revisions'\n  ]) LOOP\n    EXECUTE format('ALTER TABLE public.%I ENABLE ROW LEVEL SECURITY', t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', 'anon_select_' || t, t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', 'anon_insert_' || t, t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', 'anon_update_' || t, t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', 'anon_delete_' || t, t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', 'couple_member_select_' || t, t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', 'couple_member_insert_' || t, t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', 'couple_member_update_' || t, t);\n    EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', 'couple_member_delete_' || t, t);\n    IF t = 'couple_profile' THEN\n      EXECUTE format('CREATE POLICY %I ON public.%I FOR SELECT TO authenticated USING (public.is_couple_member(id))', 'couple_member_select_' || t, t);\n      EXECUTE format('CREATE POLICY %I ON public.%I FOR UPDATE TO authenticated USING (public.is_couple_member(id)) WITH CHECK (public.is_couple_member(id))', 'couple_member_update_' || t, t);\n      EXECUTE format('CREATE POLICY %I ON public.%I FOR DELETE TO authenticated USING (public.is_couple_member(id))', 'couple_member_delete_' || t, t);\n    ELSE\n      EXECUTE format('CREATE POLICY %I ON public.%I FOR SELECT TO authenticated USING (public.is_couple_member(couple_id))', 'couple_member_select_' || t, t);\n      EXECUTE format('CREATE POLICY %I ON public.%I FOR INSERT TO authenticated WITH CHECK (public.is_couple_member(couple_id))', 'couple_member_insert_' || t, t);\n      EXECUTE format('CREATE POLICY %I ON public.%I FOR UPDATE TO authenticated USING (public.is_couple_member(couple_id)) WITH CHECK (public.is_couple_member(couple_id))', 'couple_member_update_' || t, t);\n      EXECUTE format('CREATE POLICY %I ON public.%I FOR DELETE TO authenticated USING (public.is_couple_member(couple_id))', 'couple_member_delete_' || t, t);\n    END IF;\n  END LOOP;\nEND $$","-- Existing media remains in place. Private buckets and path policies make legacy unscoped\n-- objects inaccessible until an explicit, authorized migration is performed.\nUPDATE storage.buckets SET public = false WHERE id IN ('avatars', 'memories', 'photos', 'assets')","-- A browser-stored secondary password is not an authorization control. Redact\n-- transitional plaintext values without assigning legacy ownership.\nDO $$\nBEGIN\n  IF EXISTS (\n    SELECT 1 FROM information_schema.columns\n    WHERE table_schema = 'public' AND table_name = 'settings' AND column_name = 'privacy_password'\n  ) THEN\n    EXECUTE 'UPDATE public.settings SET privacy_password = NULL WHERE privacy_password IS NOT NULL';\n  END IF;\nEND $$","CREATE OR REPLACE FUNCTION public.storage_object_couple_id(object_path text)\nRETURNS uuid\nLANGUAGE plpgsql\nIMMUTABLE\nAS $$\nBEGIN\n  RETURN NULLIF(split_part(object_path, '/', 1), '')::uuid;\nEXCEPTION WHEN invalid_text_representation THEN\n  RETURN NULL;\nEND;\n$$","REVOKE ALL ON FUNCTION public.storage_object_couple_id(text) FROM PUBLIC","GRANT EXECUTE ON FUNCTION public.storage_object_couple_id(text) TO authenticated","DROP POLICY IF EXISTS \\"Allow public select\\" ON storage.objects","DROP POLICY IF EXISTS \\"Allow public insert\\" ON storage.objects","DROP POLICY IF EXISTS \\"Allow public update\\" ON storage.objects","DROP POLICY IF EXISTS \\"Allow public delete\\" ON storage.objects","DROP POLICY IF EXISTS storage_couple_select ON storage.objects","DROP POLICY IF EXISTS storage_couple_insert ON storage.objects","DROP POLICY IF EXISTS storage_couple_update ON storage.objects","DROP POLICY IF EXISTS storage_couple_delete ON storage.objects","CREATE POLICY storage_couple_select ON storage.objects FOR SELECT TO authenticated\n  USING (bucket_id IN ('avatars', 'memories', 'photos', 'assets')\n    AND public.is_couple_member(public.storage_object_couple_id(name)))","CREATE POLICY storage_couple_insert ON storage.objects FOR INSERT TO authenticated\n  WITH CHECK (bucket_id IN ('avatars', 'memories', 'photos', 'assets')\n    AND public.is_couple_member(public.storage_object_couple_id(name)))","CREATE POLICY storage_couple_update ON storage.objects FOR UPDATE TO authenticated\n  USING (bucket_id IN ('avatars', 'memories', 'photos', 'assets')\n    AND public.is_couple_member(public.storage_object_couple_id(name)))\n  WITH CHECK (bucket_id IN ('avatars', 'memories', 'photos', 'assets')\n    AND public.is_couple_member(public.storage_object_couple_id(name)))","CREATE POLICY storage_couple_delete ON storage.objects FOR DELETE TO authenticated\n  USING (bucket_id IN ('avatars', 'memories', 'photos', 'assets')\n    AND public.is_couple_member(public.storage_object_couple_id(name)))","REVOKE ALL ON storage.objects FROM anon","REVOKE ALL ON SCHEMA storage FROM anon"}	auth_membership_security
\.


