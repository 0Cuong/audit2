{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formygf",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "audit2-db",
      "database_id": "ad79df12-068a-43b4-ba8c-76f8d91e00e6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CORS_ORIGIN": ""
  },
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "7e363a2452a247c4a96162798758005a"
    }
  ]
}
